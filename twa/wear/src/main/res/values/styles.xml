<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WearAppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/wear_background</item>
        <item name="android:colorPrimary">@color/wear_primary</item>
        <item name="android:textColorPrimary">@color/wear_text_primary</item>
        <item name="android:windowAnimationStyle">@style/WearActivityAnimation</item>
    </style>

    <style name="WearPlayerTheme" parent="WearAppTheme">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="WearActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/player_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/browse_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/browse_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/player_exit</item>
    </style>
</resources>
