<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipChildren="false"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        app:boxedEdges="all">

        <!-- Screen 1: Languages -->
        <LinearLayout
            android:id="@+id/languages_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:text="@string/app_name"
                android:textColor="@color/wear_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="2dp"
                android:text="@string/languages_title"
                android:textColor="@color/wear_text_secondary"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/loading_languages"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/wear_primary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/languages_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_list_enter"
                android:paddingBottom="4dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Screen 2: Stations -->
        <LinearLayout
            android:id="@+id/stations_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/back_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_fa_button"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="@color/wear_text_primary" />

                <TextView
                    android:id="@+id/stations_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wear_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading_stations"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/wear_primary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stations_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_list_enter"
                android:paddingBottom="4dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </FrameLayout>
</androidx.wear.widget.BoxInsetLayout>
