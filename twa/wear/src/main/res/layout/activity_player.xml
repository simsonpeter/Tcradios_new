<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/wear_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="@string/publisher_name"
            android:textColor="@color/wear_text_secondary"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:gravity="start|center_vertical">

                <TextView
                    android:id="@+id/player_back_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_fa_button"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="@color/wear_text_primary" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/artwork_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.35"
                    android:background="@drawable/bg_artwork_spin" />

                <ImageView
                    android:id="@+id/artwork_view"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_image"
                    android:contentDescription="@string/now_playing"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_station_placeholder" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:gravity="end|center_vertical">

                <TextView
                    android:id="@+id/volume_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_fa_button"
                    android:clickable="true"
                    android:contentDescription="@string/volume"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="@color/wear_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/station_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/wear_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prev_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_fa_button"
                android:clickable="true"
                android:contentDescription="@string/previous_station"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:textColor="@color/wear_text_primary" />

            <TextView
                android:id="@+id/play_pause_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_fa_button_primary"
                android:clickable="true"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:textColor="@color/wear_text_primary" />

            <TextView
                android:id="@+id/next_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_fa_button"
                android:clickable="true"
                android:contentDescription="@string/next_station"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:textColor="@color/wear_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volume_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_card"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/volume_down_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_fa_button"
            android:clickable="true"
            android:contentDescription="@string/volume_down"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/wear_text_primary" />

        <TextView
            android:id="@+id/volume_up_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_fa_button"
            android:clickable="true"
            android:contentDescription="@string/volume_up"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/wear_text_primary" />
    </LinearLayout>
</FrameLayout>
